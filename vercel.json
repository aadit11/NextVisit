{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "services": {
    "web": {
      "root": "web",
      "framework": "vite"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 60,
          "excludeFiles": "{web/node_modules/**,.vercel/**,tests/**,**/pyarrow/**,**/pyarrow.libs/**,**/examples.parquet,**/violations.parquet,**/scipy/spatial/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/cities", "destination": { "service": "api" } },
    { "source": "/cities/:path*", "destination": { "service": "api" } },
    { "source": "/account", "destination": { "service": "api" } },
    { "source": "/account/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
